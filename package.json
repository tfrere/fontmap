{
  "name": "fontmap",
  "version": "1.0.0",
  "description": "Interactive map of 1,465 Google Fonts organized by visual similarity using FontCLIP + t-SNE",
  "author": "Thibaud Frere",
  "license": "MIT",
  "homepage": ".",
  "repository": {
    "type": "git",
    "url": "https://github.com/tfrere/fontmap"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "d3": "^7.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.3",
    "react-scripts": "5.0.1",
    "stats.js": "^0.17.0",
    "web-vitals": "^2.1.4",
    "zustand": "^5.0.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "pipeline:download": "node pipeline/render/1-download-fonts.mjs",
    "pipeline:render": "node pipeline/render/2-generate-svgs.mjs && node pipeline/render/3-generate-pngs.mjs",
    "pipeline:sentences": "mkdir -p public/data/sentences && cp pipeline/output/svgs/*_sentence.svg public/data/sentences/",
    "overlap": "node scripts/apply-overlap-removal.mjs",
    "overlap:dry": "node scripts/apply-overlap-removal.mjs --dry-run",
    "sprite": "node scripts/build-glyph-sprite.mjs"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "opentype.js": "^1.3.4",
    "sharp": "^0.34.5"
  }
}
